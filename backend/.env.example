# OceanLens Backend Environment Variables
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Data path overrides (optional).
# All paths are project-relative by default (backend/data/...).
# Override only if your datasets live outside the repository,
# e.g. on an external drive holding the 9.85 GB HYCOM source file.
# OCEANX_DATA_DIR=/absolute/path/to/data
# OCEANX_RAW_HYCOM_FILE=/absolute/path/to/RSMC_hycom_20260908.nc
# OCEANX_PROCESSED_OCEAN_FILE=/absolute/path/to/incois_hycom_bob_surface.nc
# OCEANX_PROCESSED_OCEAN_META=/absolute/path/to/incois_hycom_bob_metadata.json
# OCEANX_RAW_IBTRACS_CSV=/absolute/path/to/ibtracs.NI.list.v04r01.csv
# OCEANX_PROCESSED_ARGO_FILE=/absolute/path/to/argo_bob_processed.json
# OCEANX_PROCESSED_ARGO_META=/absolute/path/to/argo_bob_metadata.json

# Data mode — REAL (default) or FIXTURE.
# FIXTURE mode serves committed synthetic schema-compatible test fixtures from
# backend/tests/fixtures/. No production HYCOM data is required. All frontend
# endpoints function but values are constant placeholder values — not scientific
# evidence. Must be explicitly set; never activates silently.
# OCEANX_DATA_MODE=REAL
# OCEANX_DATA_MODE=FIXTURE
