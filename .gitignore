# Node dependencies
node_modules/
frontend/node_modules/
.pnp
.pnp.*

# Next.js & Build outputs
.next/
frontend/.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Python & Environment
.venv/
backend/.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
backend/.pytest_cache/

# Environment variables
.env
.env*.local
backend/.env

# Large raw scientific datasets & binary NetCDF files
# (kept local or downloaded via scripts/setup-data.py / archive_hycom_runs.py
#  - see data/manifest.json and data/README.md)
backend/data/raw/
*.nc
*.nc4
*.nc.part
*.partial
*full-download-partial
*.h5
*.hdf5
*.grib
*.grb
*.zarr
*.parquet
# Generated/processed scientific outputs are not committed
backend/data/processed/**/*.nc
backend/data/processed/**/*.json

# ...EXCEPT small synthetic test fixtures, which ARE committed
!backend/tests/fixtures/*.nc
!backend/data/processed/ocean/argo/argo_bob_processed.json
!backend/data/processed/ocean/argo/argo_bob_metadata.json
!backend/data/processed/ocean/incois_hycom_bob_metadata.json

# ...EXCEPT the demo subset, which IS committed
# backend/data/demo holds a coarsened subset of the REAL INCOIS HYCOM runs
# (~23 MB, float32+zlib) so a fresh clone has real ocean data to show. It is
# never synthetic - it is thinned, never re-invented. Regenerate with
# backend/scripts/make_demo_subset.py.
!backend/data/demo/**/*.nc


# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Playwright MCP artifacts
.playwright-mcp/

# Agent tooling scratch (worktrees, bare clones)
.delta/
.kilo/

# Diagnostic evidence CSVs live in backend/docs/diagnostics/ and are deliberately
# TRACKED: they are the evidence behind the bias and TCHP figures quoted in the
# UI, they are a few kilobytes each, and an untracked number nobody can check is
# the thing this repository is trying to avoid.
shot-*.png
verify-*.png
